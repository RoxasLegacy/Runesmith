function IsDamageRune()
  return HasStatus('ATRYL')
    | HasStatus('ATRYL') | HasStatus('ATRYL4')
    | HasStatus('ATRYL7') | HasStatus('ATRYL9')
    | HasStatus('ATRYL11')
    | HasStatus('CAMONICA') | HasStatus('CAMONICA4')
    | HasStatus('CAMONICA7') | HasStatus('CAMONICA9')
    | HasStatus('CAMONICA11') | HasStatus('RANSHUSHOCK')
    | HasStatus('LYSKEL') | HasStatus('LYSKEL4')
    | HasStatus('LYSKEL7') | HasStatus('LYSKEL9')
    | HasStatus('LYSKEL11') | HasStatus('RANSHU')
    | HasStatus('RANSHU4') | HasStatus('RANSHU7')
    | HasStatus('RANSHU9') | HasStatus('RANSHU11')
    | HasStatus('SKORUL') | HasStatus('OCHYGHOLL')
    | HasStatus('THULLAX') | HasStatus('THULLAX4')
    | HasStatus('THULLAX7') | HasStatus('THULLAX9')
    | HasStatus('THULLAX11') | HasStatus('TROLISTRI')
    | HasStatus('KALIYA') | HasStatus('KALIYA11')
end